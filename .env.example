# Optional: enables the Claude-powered planner. Without it Dost runs its deterministic playbooks.
ANTHROPIC_API_KEY=
# DOST_MODEL=claude-opus-5-5
# Force playbook mode even when a key is present:
# DOST_MODE=playbook
PORT=3000
# Seconds until a dispatched replacement device comes online (demo pacing)
DOST_REPLACEMENT_SECONDS=120

# --- Security (required when NODE_ENV=production; 16+ random chars each) ---
# Leave both tokens empty for a local, open demo.
# Operators run missions and the chaos lab; approvers also decide approvals, edit policy, export audit, reset.
DOST_OPERATOR_TOKEN=
DOST_APPROVER_TOKEN=
DOST_SESSION_SECRET=
DOST_WEBHOOK_SECRET=
# Let anonymous visitors see the read-only live preview on the landing page:
# DOST_PUBLIC_READ=1
# Set when behind a load balancer / reverse proxy (e.g. 1):
# DOST_TRUST_PROXY=1
# Requests per minute per IP on /api (default 300):
# DOST_RATE_LIMIT=300
# Where state is stored (mount a volume here in containers):
# DOST_DB_FILE=/data/db.json
